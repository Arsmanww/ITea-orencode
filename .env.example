# Файл .env необязателен: те же значения по умолчанию заданы в docker-compose.yml.
# Скопируйте его в .env только чтобы изменить настройки.
# --- PostgreSQL ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_demo_password
POSTGRES_DB=fsp
# Для запуска backend вне Docker (uvicorn на хосте); в compose переопределяется на db:5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
SECRET_KEY=dev-secret-change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Список через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Порты на хосте ---
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# --- Демо-данные ---
# true: при старте api заполнить пустую БД справочниками и фиктивными данными 2023-2026
SEED_ON_START=true

# --- Бот в мессенджере MAX (внешний канал уведомлений; пусто — уведомления только в личном кабинете) ---
# Токен выдаёт MasterBot в MAX (max.ru/MasterBot) при создании бота; username — ник бота без @.
# Пользователь привязывает MAX одной кнопкой в кабинете: ссылка max.ru/<бот>?start=<код>.
# Вебхук не нужен: события бот получает long polling'ом. Сертификат API (НУЦ Минцифры) лежит в backend/app/services/certs.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# --- Справки с QR-кодом ---
# Адрес, на который ведёт QR-код (страница проверки подлинности /verify/<uuid>)
PUBLIC_BASE_URL=http://localhost:3000
