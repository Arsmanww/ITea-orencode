# Файл .env необязателен: те же значения по умолчанию заданы в docker-compose.yml.
# Скопируйте его в .env только чтобы изменить настройки.
# --- PostgreSQL ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_demo_password
POSTGRES_DB=fsp
# Для запуска backend вне Docker (uvicorn на хосте); в compose переопределяется на db:5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
SECRET_KEY=dev-secret-change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Список через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Порты на хосте ---
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# --- Демо-данные ---
# true: при старте api заполнить пустую БД справочниками и фиктивными данными 2023-2026
SEED_ON_START=true

# --- Почта (внешний канал уведомлений + письма восстановления пароля; пусто — уведомления только
#      в личном кабинете, а ссылка для сброса пароля пишется в лог api: `docker compose logs api`) ---
# Любой SMTP-провайдер (Gmail, Mail.ru, Yandex и т.д.); для Gmail/Mail.ru обычно нужен пароль приложения.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=ФСП Оренбургской области <noreply@fsp-orenburg.example>
# Сколько минут действует ссылка для сброса пароля
PASSWORD_RESET_TTL_MINUTES=60

# --- Справки с QR-кодом ---
# Адрес, на который ведёт QR-код (страница проверки подлинности /verify/<uuid>)
PUBLIC_BASE_URL=http://localhost:3000
